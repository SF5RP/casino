# Casino Backend Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casino_db
DB_USER=casino_user
DB_PASSWORD=your_secure_password
DB_SSL_MODE=disable

# Server Configuration
PORT=8011
GRPC_PORT=8012

# CORS Configuration
# Leave empty to allow all origins without credentials
# Set to specific URL (e.g., https://yourdomain.com) to enable credentials
FRONTEND_URL=

# Logging
LOG_LEVEL=info

# Security
JWT_SECRET=your_jwt_secret_key_here
API_KEY=your_api_key_here

# Application Settings
APP_ENV=development
APP_DEBUG=true
