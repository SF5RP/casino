# Casino Backend Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casino_db
DB_USER=casino_user
DB_PASSWORD=your_secure_password
DB_SSL_MODE=disable

# Server Configuration
PORT=8011
GRPC_PORT=8012

# CORS Configuration
# Leave empty to allow all origins without credentials
# Set to specific URL (e.g., https://yourdomain.com) to enable credentials
FRONTEND_URL=

# Auth Service Integration
# URL of the external Auth service (Discord OAuth)
AUTH_SERVICE_URL=http://localhost:8000

# User/admin token verification mode:
# - introspection: remote verification via AUTH_INTROSPECTION_URL or AUTH_SERVICE_URL/api/me
# - jwks: local JWT verification via AUTH_JWKS_URL
AUTH_VERIFICATION_MODE=introspection
AUTH_INTROSPECTION_URL=
AUTH_INTROSPECTION_METHOD=GET
AUTH_JWKS_URL=
AUTH_HTTP_TIMEOUT_SECONDS=5
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_EXPECTED_ISSUER=
AUTH_EXPECTED_AUDIENCE=

# Logging
LOG_LEVEL=info

# Security
# Internal secret used only for backend-issued room tokens and gRPC room auth
ROOM_JWT_SECRET=your_room_jwt_secret_here
# Deprecated fallback for room tokens only. Prefer ROOM_JWT_SECRET.
JWT_SECRET=
API_KEY=your_api_key_here

# Application Settings
APP_ENV=development
APP_DEBUG=true
