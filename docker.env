# Docker Environment Variables for Casino Roulette

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casino_db
DB_USER=casino_user
DB_PASSWORD=casino_password
DB_SSL_MODE=disable

# Backend Server Configuration
PORT=8011
SERVER_HOST=0.0.0.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8011/api
NEXT_PUBLIC_WS_URL=ws://localhost:8011/ws

# pgAdmin Configuration (optional)
PGADMIN_DEFAULT_EMAIL=admin@casino.local
PGADMIN_DEFAULT_PASSWORD=admin123

# Security (change these in production!)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
API_KEY=your_api_key_here_change_in_production

# Application Settings
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=info
